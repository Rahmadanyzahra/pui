rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for role-based access control
    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function getUserRole(uid) {
      return getUserDoc(uid).data.selectedRole;
    }

    function isParentRole(uid) {
      return getUserRole(uid) in ['parent', 'delegated_parent', 'assistant'];
    }

    function isChildRole(uid) {
      return getUserRole(uid) == 'child';
    }

    function isDelegatedParent(uid) {
      return getUserRole(uid) == 'delegated_parent';
    }

    function canAccessChildAsDelegate(delegateUid, childId) {
      return isDelegatedParent(delegateUid) &&
             childId in getUserDoc(delegateUid).data.assignedChildren;
    }

    // Allow authenticated users to read and write their own user document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow list: if request.auth != null;
    }

    // Allow authenticated users to manage child profiles with role-based access
    match /child_profiles/{childId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.parentId ||
        canAccessChildAsDelegate(request.auth.uid, childId)
      );
      
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.parentId ||
        (isParentRole(request.auth.uid) && canAccessChildAsDelegate(request.auth.uid, childId))
      );
      
      allow create: if request.auth != null && request.auth.uid == request.resource.data.parentId;
      
      allow list: if request.auth != null;
    }

    // Alternative children collection path
    match /children/{childId} {
      allow read, write: if request.auth != null;
      allow create: if request.auth != null;
      allow list: if request.auth != null;
    }

    // Activity tracking with role-based access
    match /activities/{activityId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.parentId ||
        canAccessChildAsDelegate(request.auth.uid, resource.data.childId)
      );
      
      allow write: if request.auth != null && isParentRole(request.auth.uid);
      allow list: if request.auth != null;
    }

    // User tracking data with subcollections and role-based access
    match /tracking/{uid}/{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid ||
        (isParentRole(request.auth.uid) && canAccessChildAsDelegate(request.auth.uid, uid))
      );
    }

    // Screen time tracking with role-based access
    match /screen_time/{uid}/{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid ||
        (isParentRole(request.auth.uid) && canAccessChildAsDelegate(request.auth.uid, uid))
      );
    }

    // Invite codes - only parent can manage
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isParentRole(request.auth.uid);
      allow update: if request.auth != null && isParentRole(request.auth.uid);
    }

    // Reports collection with role-based access
    match /reports/{reportId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        isParentRole(request.auth.uid)
      );
      
      allow write: if request.auth != null && isParentRole(request.auth.uid);
      allow list: if request.auth != null;
    }

    // Family notifications sent by parent to a child dashboard
    match /family_notifications/{notificationId} {
      allow create: if request.auth != null && isParentRole(request.auth.uid)
        && request.auth.uid == request.resource.data.parentId
        && exists(/databases/$(database)/documents/child_profiles/$(request.resource.data.childProfileId))
        && (get(/databases/$(database)/documents/child_profiles/$(request.resource.data.childProfileId)).data.parentId == request.auth.uid ||
            canAccessChildAsDelegate(request.auth.uid, request.resource.data.childProfileId));

      allow read: if request.auth != null && (
        request.auth.uid == resource.data.parentId ||
        request.auth.uid == resource.data.recipientUid ||
        canAccessChildAsDelegate(request.auth.uid, resource.data.childProfileId)
      );

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.parentId ||
        request.auth.uid == resource.data.recipientUid ||
        canAccessChildAsDelegate(request.auth.uid, resource.data.childProfileId)
      );

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.parentId ||
        canAccessChildAsDelegate(request.auth.uid, resource.data.childProfileId)
      );
    }

    // Gamification data with role-based access
    match /gamification_data/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (isParentRole(request.auth.uid) && canAccessChildAsDelegate(request.auth.uid, resource.data.userId))
      );
      
      allow write: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isParentRole(request.auth.uid)
      );
    }

    // Backward-compatible alias for older data naming
    match /gamificationData/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId ||
        (isParentRole(request.auth.uid) && canAccessChildAsDelegate(request.auth.uid, userId))
      );
    }

    // Point transaction history for gamification
    match /point_transactions/{transactionId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (isParentRole(request.auth.uid) && canAccessChildAsDelegate(request.auth.uid, resource.data.userId))
      );
      
      allow write: if request.auth != null && isParentRole(request.auth.uid);
    }
  }
}
